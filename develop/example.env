# Variables de ejemplo para desarrollar caja-backend en local.
#
#   cp develop/example.env develop/.env      # develop/.env está en .gitignore: nunca se versiona
#   set -a; source develop/.env; set +a      # exporta las variables al shell actual
#   ./gradlew bootRun
#
# Guía completa: docs/develop/README.md

# --- Base de datos (compose.yml: postgres:18 en 127.0.0.1:5434, base/usuario/clave caja) ---
WASICHAI_DB_HOST=localhost
WASICHAI_DB_PORT=5434
WASICHAI_DB_NAME=caja
WASICHAI_DB_USERNAME=caja
WASICHAI_DB_PASSWORD=caja
# puerto que publica compose.yml (debe coincidir con WASICHAI_DB_PORT)
CAJA_PG_PORT=5434

# --- Seguridad ---
# >= 32 bytes. solo para desarrollo: en cualquier entorno real, uno propio y secreto
WASICHAI_JWT_SECRET=caja-dev-only-secret-change-me-0123456789
# crea admin@wasichai.local / admin. apagarlo (false) fuera de desarrollo
WASICHAI_SEED_DEV=true

# --- Scripts de carga del modelo (model/apply.py e importadores) ---
WASICHAI_CORE=http://localhost:8091
WASICHAI_EMAIL=admin@wasichai.local
WASICHAI_PASSWORD=admin

# --- GitHub Packages (librerías wasichai). Opcional si ya están en ~/.gradle/gradle.properties (gpr.user/gpr.key) ---
# GITHUB_ACTOR=<usuario de github>
# GITHUB_TOKEN=<PAT con read:packages>

# --- Tests de integración contra una base externa (solo con Docker remoto). El nombre debe terminar en _test ---
# WASICHAI_TEST_DB_HOST=localhost
# WASICHAI_TEST_DB_PORT=5443
# WASICHAI_TEST_DB_NAME=caja_test
# WASICHAI_TEST_DB_USERNAME=caja
# WASICHAI_TEST_DB_PASSWORD=<clave>
